source "https://rubygems.org"

# Matches the exact Jekyll + plugin versions GitHub Pages runs, so a local
# preview renders the same as the deployed site.
gem "github-pages", group: :jekyll_plugins

# Jekyll 3.9 doesn't bundle a web server, and Ruby 3 dropped webrick from stdlib.
gem "webrick"

# Windows has no system timezone database.
gem "tzinfo-data"
